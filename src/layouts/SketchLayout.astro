---
import BaseLayout from "./BaseLayout.astro";

type SketchLink = {
	id: string;
	title: string;
};

const { title, description, pubDate, prev, next } = Astro.props as {
	title: string;
	description: string;
	pubDate: Date;
	prev: SketchLink | null;
	next: SketchLink | null;
};

const formattedDate = pubDate.toLocaleDateString("en-AU", {
	day: "numeric",
	month: "long",
	year: "numeric",
});
---

<BaseLayout frontmatter={{ title }}>
	<div class="mx-auto max-w-4xl px-6 pt-12 pb-8">
		<nav class="mb-8 flex flex-wrap gap-x-4 gap-y-2 text-sm">
			<a href="/" class="hover:text-primary underline">home</a>
			{
				prev ? (
					<a href={`/sketches/${prev.id}/`} class="hover:text-primary underline">
						prev · {prev.title}
					</a>
				) : null
			}
			{
				next ? (
					<a href={`/sketches/${next.id}/`} class="hover:text-primary underline">
						next · {next.title}
					</a>
				) : null
			}
		</nav>
		<p class="text-sm tracking-wide text-slate-500 uppercase">{formattedDate}</p>
		<h1 class="font-space-grotesk text-primary mt-2 text-4xl">{title}</h1>
		<p class="mt-3">{description}</p>
	</div>
	<slot />
</BaseLayout>
