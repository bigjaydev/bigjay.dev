---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const sketches = (await getCollection("sketches")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = sketches[0];
const recent = sketches.slice(1, 4);
const earlier = sketches.slice(4);

const shortDate = (date: Date) =>
	date.toLocaleDateString("en-AU", { day: "numeric", month: "short", year: "numeric" });
const dayNum = (date: Date) => date.toLocaleDateString("en-AU", { day: "2-digit" });
const monthYear = (date: Date) =>
	date.toLocaleDateString("en-AU", { month: "long", year: "numeric" });
---

<BaseLayout frontmatter={{ title: "bigjay.dev" }}>
	<div class="min-h-svh bg-[#e3e5e1] sm:px-6 sm:py-8">
		<div
			class="border-ink bg-paper mx-auto min-h-svh max-w-[1080px] border sm:min-h-[calc(100svh-4rem)]"
		>
			<header class="border-ink flex items-start justify-between gap-8 border-b px-6 py-6 sm:px-8 sm:py-8">
				<div>
					<p class="font-mast text-ink w-fit text-[4.25rem] leading-[0.78] sm:text-[5.5rem]">
						<span class="border-ink block border-b pb-1">Bigjay</span>
						<span class="block pt-1">Dev</span>
					</p>
					<p class="text-graphite mt-5 max-w-[11rem] text-sm leading-relaxed">
						A sketch a day, drawn in the browser.
					</p>
				</div>
				<nav class="border-ink text-ink flex shrink-0 items-center border-l pl-5 text-sm">
					<a href="/" class="pr-4">Index</a>
					{
						latest && (
							<a href={`/sketches/${latest.id}/`} class="border-ink border-l pl-4">
								Latest
							</a>
						)
					}
				</nav>
			</header>

			{
				latest && (
					<section class="border-ink grid border-b md:grid-cols-2">
						<div class="px-6 py-10 sm:px-8">
							<p class="text-graphite text-[11px] tracking-[0.22em] uppercase">Latest</p>
							<h2 class="font-display text-ink mt-4 text-5xl sm:text-6xl">
								<a href={`/sketches/${latest.id}/`} class="no-underline">
									{latest.data.title}
								</a>
							</h2>
							<p class="text-graphite mt-5 max-w-sm text-sm leading-relaxed">
								{latest.data.description}
							</p>
							<a
								href={`/sketches/${latest.id}/`}
								class="text-ink mt-8 inline-flex items-center gap-3 text-sm no-underline"
							>
								Open
								<span class="bg-ink h-px w-8" />
							</a>
						</div>
						<a
							href={`/sketches/${latest.id}/`}
							class="bg-mist relative block min-h-80 text-[#f7f7f4] no-underline hover:bg-[#b7c8d1]"
						>
							<span class="pointer-events-none absolute inset-4 border border-[#f7f7f4]/70" />
							<span class="absolute top-8 right-8 text-[10px] tracking-[0.22em] uppercase">
								Sketch
							</span>
							<span class="date-stroke absolute top-1/2 left-8 -translate-y-1/2 text-[7.5rem] leading-none">
								{dayNum(latest.data.pubDate)}
							</span>
							<span class="absolute top-1/2 right-6 -translate-y-1/2 text-[11px] tracking-[0.28em] uppercase [writing-mode:vertical-rl]">
								{monthYear(latest.data.pubDate)}
							</span>
							<span class="absolute bottom-8 left-8 border border-[#f7f7f4]/80 px-3 py-2 text-sm">
								{latest.data.title}
							</span>
						</a>
					</section>
				)
			}

			{
				recent.length > 0 && (
					<section>
						<p class="text-graphite px-6 pt-8 text-[11px] tracking-[0.22em] uppercase sm:px-8">
							Recent
						</p>
						<ul>
							{recent.map((sketch) => (
								<li class="border-rule border-b">
									<a
										href={`/sketches/${sketch.id}/`}
										class="grid gap-3 px-6 py-8 no-underline sm:px-8 md:grid-cols-[1fr_auto] md:items-start"
									>
										<span>
											<span class="font-display text-ink block text-4xl">{sketch.data.title}</span>
											<span class="text-graphite mt-3 block max-w-md text-sm leading-relaxed">
												{sketch.data.description}
											</span>
											<span class="text-ink mt-5 inline-flex items-center gap-3 text-sm">
												Open
												<span class="bg-ink h-px w-8" />
											</span>
										</span>
										<span class="text-graphite text-[11px] tracking-[0.16em] uppercase md:pt-2">
											{shortDate(sketch.data.pubDate)}
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			{
				earlier.length > 0 && (
					<section class="px-6 py-8 sm:px-8">
						<p class="text-graphite text-[11px] tracking-[0.22em] uppercase">Earlier</p>
						<ul class="border-ink mt-4 border-t">
							{earlier.map((sketch) => (
								<li class="border-rule border-b">
									<a
										href={`/sketches/${sketch.id}/`}
										class="text-ink flex items-baseline justify-between gap-6 py-3 no-underline hover:bg-[#e7eef1]"
									>
										<span>{sketch.data.title}</span>
										<span class="text-graphite shrink-0 text-[11px] tracking-[0.16em] uppercase">
											{shortDate(sketch.data.pubDate)}
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			<footer
				class="bg-mist text-ink flex items-center justify-between px-6 py-4 text-[11px] tracking-[0.18em] uppercase sm:px-8"
			>
				<span>bigjay.dev</span>
				<span>{latest ? monthYear(latest.data.pubDate) : "Sketches"}</span>
			</footer>
		</div>
	</div>
</BaseLayout>
