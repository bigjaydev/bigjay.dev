---
import { getCollection, getEntry, render } from "astro:content";
import SketchLayout from "../../layouts/SketchLayout.astro";

export async function getStaticPaths() {
	const sketches = await getCollection("sketches");
	return sketches.map((sketch) => ({
		params: { slug: sketch.id },
	}));
}

const sketches = (await getCollection("sketches")).sort(
	(a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
);
const sketch = await getEntry("sketches", Astro.params.slug!);

if (!sketch) {
	return Astro.redirect("/404");
}

const index = sketches.findIndex((entry) => entry.id === sketch.id);
const prev = index > 0 ? sketches[index - 1] : null;
const next = index >= 0 && index < sketches.length - 1 ? sketches[index + 1] : null;

const { Content } = await render(sketch);
---

<SketchLayout
	title={sketch.data.title}
	description={sketch.data.description}
	pubDate={sketch.data.pubDate}
	prev={prev ? { id: prev.id, title: prev.data.title } : null}
	next={next ? { id: next.id, title: next.data.title } : null}
>
	<Content />
</SketchLayout>
