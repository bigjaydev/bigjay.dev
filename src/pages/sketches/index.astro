---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Link from "../../components/Link.astro";

const sketches = (await getCollection("sketches")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout frontmatter={{ title: "Sketches" }}>
	<div>
		<h1 class="text-primary mb-8 text-4xl font-bold">Sketches</h1>
		<div class="space-y-8">
			<article class="border-b pb-8">
				<p class="text-sm text-gray-500">6/11/2026</p>
				<h2 class="mt-1 text-2xl font-semibold">11-06</h2>
				<p class="mt-3 text-gray-600">World news</p>
				<Link href="/sketches/2026-11-06/" class="mt-4">
					Open
					<span class="sr-only"> 11-06</span>
				</Link>
			</article>
			{
				sketches
					.filter((sketch) => sketch.id !== "2026-11-06")
					.map((sketch) => (
					<article class="border-b pb-8">
						<p class="text-sm text-gray-500">{sketch.data.pubDate.toLocaleDateString()}</p>
						<h2 class="mt-1 text-2xl font-semibold">{sketch.data.title}</h2>
						<p class="mt-3 text-gray-600">{sketch.data.description}</p>
						<Link href={`/sketches/${sketch.id}/`} class="mt-4">
							Open
							<span class="sr-only"> {sketch.data.title}</span>
						</Link>
					</article>
				))
			}
		</div>
	</div>
</BaseLayout>
